<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 9 ve altinda videoyu kaydetmek icin gerekli -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!--
      Android 11+ paket gorunurlugu: yerlesik galeriyi bulabilmek icin
      videoyu acabilen uygulamalari ve bilinen galeri paketlerini sorabilmeliyiz.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_GALLERY" />
        </intent>
        <package android:name="com.hihonor.photos" />
        <package android:name="com.huawei.photos" />
        <package android:name="com.android.gallery3d" />
        <package android:name="com.sec.android.gallery3d" />
        <package android:name="com.miui.gallery" />
        <package android:name="com.oplus.gallery" />
        <package android:name="com.coloros.gallery3d" />
        <package android:name="com.oneplus.gallery" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DroneCamera">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
