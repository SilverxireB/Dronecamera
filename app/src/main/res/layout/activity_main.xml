<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/zoomText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/pill_background"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="@string/zoom_placeholder"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/countdownText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/pill_background"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:textColor="@color/recording"
        android:textSize="14sp"
        android:visibility="gone"
        android:text="@string/countdown_placeholder"
        app:layout_constraintTop_toBottomOf="@id/zoomText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="8dp"
        android:max="100"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/durationGroup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <CheckBox
        android:id="@+id/singleLens"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:checked="false"
        android:text="@string/single_lens"
        android:textColor="@android:color/white"
        android:buttonTint="@color/accent"
        app:layout_constraintBottom_toTopOf="@id/lockExposure"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <CheckBox
        android:id="@+id/lockExposure"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:checked="true"
        android:text="@string/lock_exposure"
        android:textColor="@android:color/white"
        android:buttonTint="@color/accent"
        app:layout_constraintBottom_toTopOf="@id/durationGroup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <RadioGroup
        android:id="@+id/durationGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/directionToggle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RadioButton
            android:id="@+id/duration10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/duration_10"
            android:textColor="@android:color/white"
            android:buttonTint="@color/accent" />

        <RadioButton
            android:id="@+id/duration15"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/duration_15"
            android:textColor="@android:color/white"
            android:buttonTint="@color/accent" />

        <RadioButton
            android:id="@+id/duration20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/duration_20"
            android:textColor="@android:color/white"
            android:buttonTint="@color/accent" />

        <RadioButton
            android:id="@+id/duration30"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/duration_30"
            android:textColor="@android:color/white"
            android:buttonTint="@color/accent" />
    </RadioGroup>

    <Button
        android:id="@+id/directionToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/panel"
        android:textColor="@android:color/white"
        android:text="@string/mode_zoom_out"
        app:layout_constraintBottom_toTopOf="@id/recordButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/recordButton"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginHorizontal="48dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="@color/accent"
        android:textColor="@android:color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        android:text="@string/start_shot"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
